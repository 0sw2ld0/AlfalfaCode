    },
    "reply_to": {
      "type": "string",
      "minLength": 8
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "hello"
        },
        "payload": {
          "type": "object",
          "properties": {
            "versions": {
              "type": "array",
