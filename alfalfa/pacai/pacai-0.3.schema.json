              "additionalProperties": true
            },
            {
              "if": {
                "properties": {
                  "decision": {
                    "const": "approved"
                  }
                }
              },
              "then": {
                "required": [
                  "scope"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "scope"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "reply_to"
