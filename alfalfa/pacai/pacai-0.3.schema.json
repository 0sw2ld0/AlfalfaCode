      "allOf": [
        {
          "if": {
            "properties": {
              "sender": {
                "const": "client"
              }
            }
          },
          "then": {
            "required": [
              "reply_to"
            ]
          }
        }
      ]
    },
    {
      "properties": {
        "type": {
          "const": "approval_request"
        },
        "payload": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 8
            },
            "tool_call_id": {
              "type": "string",
              "minLength": 8
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "object"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "reason": {
              "type": "string",
              "pattern": "^(dangerous|network|outside_sandbox|sandbox_denied_retry|external_tool|policy|[a-z][a-z0-9_]*\\.[a-z0-9_.]+)$"
            },
            "scopes": {
              "type": "array",
              "items": {
                "enum": [
                  "once",
                  "session"
                ]
