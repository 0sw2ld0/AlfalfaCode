              "payload": {
                "not": {
                  "properties": {
                    "relayed": {
                      "const": true
                    }
                  },
                  "required": [
                    "relayed"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "decision": {
                    "enum": [
                      "expired",
                      "cancelled"
                    ]
                  }
                }
