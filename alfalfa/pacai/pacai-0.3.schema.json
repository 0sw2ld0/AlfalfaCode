                "required": [
                  "truncated"
                ]
              },
              "then": {
                "properties": {
                  "side": {
                    "const": "agent"
                  }
                },
                "not": {
                  "required": [
                    "approval_id"
                  ]
                }
              }
            }
          ]
        },
        "sender": {
          "const": "agent"
        }
      }
