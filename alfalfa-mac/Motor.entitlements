<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- El Python del motor con hardened runtime. Todas sus extensiones (.so) van firmadas con
	     el mismo equipo, así que la validación de bibliotecas no hace falta desactivarla.
	     Apple Events: como la app, por si un agente usa osascript. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
